# Copie para .env (cp .env.example .env) e troque os valores antes de subir o ambiente.
# O arquivo .env está no .gitignore: segredos nunca vão para o repositório.

# Senha do superusuário do Postgres (usado apenas para criar bancos/usuários)
POSTGRES_PASSWORD=troque-postgres-admin

# Senhas dos usuários de aplicação (um usuário/banco por API — menor privilégio)
CONTRATOS_DB_PASSWORD=troque-contratos-db
FLASH_SALES_DB_PASSWORD=troque-flash-sales-db

# Senha do Redis (requirepass)
REDIS_PASSWORD=troque-redis

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-grafana

# Porta pública do gateway
GATEWAY_PORT=8080
